{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ModelForge: configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                ".",
                "-B",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "ModelForge: build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: configure",
            "problemMatcher": "$gcc"
        },
        {
            "label": "ModelForge: test",
            "type": "shell",
            "command": "ctest",
            "args": [
                "--test-dir",
                "build",
                "-C",
                "Release",
                "--output-on-failure"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": []
        },
        {
            "label": "ModelForge: run demo",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge.exe",
            "args": [
                "ModelForge\\review_2_core_implementation\\models\\iris_demo.mforge",
                "--out",
                "build\\generated",
                "--dump-cpp"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": []
        },
        {
            "label": "ModelForge: configure generated",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "build/generated",
                "-B",
                "build/generated/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: run demo",
            "problemMatcher": []
        },
        {
            "label": "ModelForge: build generated",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "build/generated/build",
                "--config",
                "Release"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: configure generated",
            "problemMatcher": "$gcc"
        },
        {
            "label": "ModelForge: run generated",
            "type": "shell",
            "command": ".\\build\\generated\\build\\Release\\generated_model.exe",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build generated",
            "problemMatcher": []
        },
        {
            "label": "ModelForge: studio (terminal view)",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge_studio.exe",
            "args": [],
            "linux": {
                "command": "./build/Release/modelforge_studio"
            },
            "osx": {
                "command": "./build/Release/modelforge_studio"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "ModelForge: studio demo (all screens)",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge_studio.exe",
            "args": [
                "--demo"
            ],
            "linux": {
                "command": "./build/Release/modelforge_studio"
            },
            "osx": {
                "command": "./build/Release/modelforge_studio"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "ModelForge: research benchmark (96 models)",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge_bench.exe",
            "args": [],
            "linux": {
                "command": "./build/Release/modelforge_bench"
            },
            "osx": {
                "command": "./build/Release/modelforge_bench"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "ModelForge: research benchmark (quick)",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge_bench.exe",
            "args": [
                "--quick"
            ],
            "linux": {
                "command": "./build/Release/modelforge_bench"
            },
            "osx": {
                "command": "./build/Release/modelforge_bench"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "ModelForge: shrink and check (Wine model)",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge.exe",
            "args": [
                "ModelForge\\review_2_core_implementation\\models\\real\\wine_mlp16.mforge",
                "--shrink",
                "all",
                "--data",
                "ModelForge\\review_2_core_implementation\\models\\real\\wine_test.csv",
                "--out",
                "build\\shrink"
            ],
            "linux": {
                "command": "./build/Release/modelforge",
                "args": [
                    "ModelForge/review_2_core_implementation/models/real/wine_mlp16.mforge",
                    "--shrink",
                    "all",
                    "--data",
                    "ModelForge/review_2_core_implementation/models/real/wine_test.csv",
                    "--out",
                    "build/shrink"
                ]
            },
            "osx": {
                "command": "./build/Release/modelforge",
                "args": [
                    "ModelForge/review_2_core_implementation/models/real/wine_mlp16.mforge",
                    "--shrink",
                    "all",
                    "--data",
                    "ModelForge/review_2_core_implementation/models/real/wine_test.csv",
                    "--out",
                    "build/shrink"
                ]
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "Temper: deployment dossier (Wine)",
            "type": "shell",
            "command": ".\\build\\Release\\temper.exe",
            "args": [
                "ModelForge/review_2_core_implementation/models/real/wine_mlp16.mforge",
                "--data",
                "ModelForge/review_2_core_implementation/models/real/wine_test.csv",
                "--out",
                "build/temper_wine"
            ],
            "linux": {
                "command": "./build/Release/temper"
            },
            "osx": {
                "command": "./build/Release/temper"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "Temper: compare hand-optimised Iris (bug)",
            "type": "shell",
            "command": ".\\build\\Release\\temper.exe",
            "args": [
                "ModelForge/review_2_core_implementation/models/iris_demo.mforge",
                "--compare",
                "ModelForge/review_2_core_implementation/models/iris_handopt_bug.mforge"
            ],
            "linux": {
                "command": "./build/Release/temper"
            },
            "osx": {
                "command": "./build/Release/temper"
            },
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "ModelForge: build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        }
    ]
}