{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug ModelForge demo",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/modelforge.exe",
            "args": [
                "${workspaceFolder}/ModelForge/review_2_core_implementation/models/iris_demo.mforge",
                "--out",
                "${workspaceFolder}/build/generated"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "ModelForge: build",
            "console": "integratedTerminal"
        },
        {
            "name": "ModelForge Studio (terminal dashboard)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/Release/modelforge_studio.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "preLaunchTask": "ModelForge: build",
            "console": "integratedTerminal"
        }
    ]
}
