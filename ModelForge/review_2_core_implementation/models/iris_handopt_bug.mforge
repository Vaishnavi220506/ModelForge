# Hand-optimised copy of iris_demo with a subtle bug: one weight of dense_2 mistyped (0.5 -> 0.505).
model iris_classifier
input x float32 1,4
output y float32 1,3

tensor w1 float32 4,3 values=0.5,-0.2,0.1,0.4,0.3,-0.1,-0.3,0.2,0.6,0.1,0.5,-0.4
tensor b1 float32 1,3 values=0.0,0.1,0.0
tensor w2 float32 3,3 values=0.2,-0.1,0.3,0.1,0.4,-0.2,-0.3,0.2,0.505
tensor b2 float32 1,3 values=0.1,0.2,0.7

node dense_1 Gemm x w1 b1 -> hidden1
node activation_1 Relu hidden1 -> hidden2
node dense_2 Gemm hidden2 w2 b2 -> scores
node probabilities Softmax scores -> y axis=1

