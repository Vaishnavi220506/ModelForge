{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ModelForge: configure",
            "type": "shell",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "options": {"cwd": "${workspaceFolder}"},
            "problemMatcher": []
        },
        {
            "label": "ModelForge: build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Release"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "ModelForge: configure",
            "problemMatcher": "$gcc"
        },
        {
            "label": "ModelForge: test",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "-C", "Release", "--output-on-failure"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "ModelForge: build",
            "problemMatcher": []
        },
        {
            "label": "ModelForge: run demo",
            "type": "shell",
            "command": ".\\build\\Release\\modelforge.exe",
            "args": ["models\\iris_demo.mforge", "--out", "generated", "--dump-cpp"],
            "options": {"cwd": "${workspaceFolder}"},
            "dependsOn": "ModelForge: build",
            "problemMatcher": []
        }
    ]
}
